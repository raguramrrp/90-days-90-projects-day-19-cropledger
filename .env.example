# CropLedger Environment Configuration
# Copy this file to .env and adjust values before running in production.
# Never commit .env or live API keys to version control.

# Application Settings
CROPLEDGER_APP_NAME=CropLedger
CROPLEDGER_HOST=127.0.0.1
CROPLEDGER_PORT=8000
CROPLEDGER_ENV=development

# Database Configuration
# Option A: PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/cropledger
# Option B: Local SQLite fallback (zero-config default for Windows MVP)
DATABASE_URL=sqlite:///data/cropledger.db

# Optional PostgreSQL discrete settings (used if DATABASE_URL is left empty)
PGHOST=localhost
PGPORT=5432
PGDATABASE=cropledger
PGUSER=postgres
PGPASSWORD=

# Official data.gov.in AGMARKNET API Configuration
# Obtain a free API key from https://www.data.gov.in/
# Resource ID 9ef84268-d588-465a-a308-a864a43d0070 = Current Daily Price of Various Commodities (AGMARKNET)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_TIMEOUT_SEC=15

# Default Demo Mode Behaviour
# When true and database has zero records on startup, seeds the clearly labelled CropLedger Demo Dataset.
CROPLEDGER_SEED_DEMO_ON_EMPTY=true
